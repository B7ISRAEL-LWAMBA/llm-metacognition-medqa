# Copy this file to .env and fill in your keys. .env is gitignored.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models under test. Record the exact names in the README when you run.
CLAUDE_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-5.4-mini

# Reasoning effort for both providers (low keeps cost down and makes the
# two models more comparable). Options: low, medium, high.
REASONING_EFFORT=low
